{
  "name": "dsh-evidence-agent",
  "version": "0.1.0",
  "description": "A DeepSeek Harness plugin.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "skills",
    "knowledge/sources.json",
    "knowledge/manifest.jsonl",
    "knowledge/canonical",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "knowledge:manifest": "node scripts/build-knowledge-manifest.js",
    "knowledge:manifest:check": "node scripts/build-knowledge-manifest.js --check",
    "embeddings:build": "node scripts/build-embedding-index.js",
    "embeddings:check": "node scripts/build-embedding-index.js --check",
    "embeddings:rebuild": "node scripts/build-embedding-index.js --force",
    "bm25:build": "node scripts/build-bm25-index.js",
    "bm25:check": "node scripts/build-bm25-index.js --check",
    "bm25:search": "node scripts/search-bm25.js",
    "hybrid:search": "node scripts/search-hybrid.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-skill": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  }
}
